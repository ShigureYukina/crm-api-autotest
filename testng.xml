<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CRM接口自动化测试" verbose="1">
    <listeners>
        <!-- 全局注入失败自动重试,无需在每个 @Test 上单独声明 -->
        <listener class-name="com.crm.autotest.utils.RetryListener"/>
    </listeners>

    <test name="登录模块">
        <classes>
            <class name="com.crm.autotest.testcase.LoginTest"/>
        </classes>
    </test>

    <test name="客户模块">
        <classes>
            <class name="com.crm.autotest.testcase.CustomerTest"/>
        </classes>
    </test>
</suite>
